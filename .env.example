# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# OpenRouter — unified gateway for both chat and embedding.
# One key covers all models; switch providers by changing CHAT_MODEL / EMBEDDING_MODEL.
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Chat models (swap in Claude / GPT / Llama by changing these IDs)
CHAT_MODEL=qwen/qwen-2.5-72b-instruct
CHAT_SMALL_MODEL=qwen/qwen-2.5-7b-instruct

# Embedding model — update EMBEDDING_DIM to match when switching models.
# Qwen3-Embedding-8B: 4096 | 4B: 2560 | 0.6B: 1024
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096

# Frontend-only static demo build. Use `VITE_DEMO_ONLY=true pnpm build`
# inside web/ when deploying without FastAPI/Neo4j.
VITE_DEMO_ONLY=false
VITE_API_BASE=http://localhost:8000
